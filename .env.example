# Server
PORT=4000

# PostgreSQL — when set, orders + menu (products) + inventory (ingredients + recipes)
# are stored in table `pos_collection_docs` instead of data/*.json.
# Example: postgresql://user:pass@localhost:5432/pos
# DATABASE_URL=


# JWT — must stay stable; changing it invalidates every issued token (everyone must sign in again).
# Trimmed when read. Leave unset in dev to use the built-in default.
# JWT_SECRET=your-secret-key

# SMTP - required for OTP to be sent to Gmail (not shown on page)
# Gmail: enable 2-Step Verification, then create App Password - https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-gmail@gmail.com

# Platform seller — sign-up at /super-admin/signup (must restart backend after changing)
# Use a long random string in production. The form "Setup key" must match exactly.
# SUPER_ADMIN_SIGNUP_SECRET=
# Optional: allow more than one super_admin user (default: only one)
# SUPER_ADMIN_ALLOW_MULTIPLE=false
# Alternative bootstrap (no signup form): creates seller on first server start if email not in users.json
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_PHONE=

# Razorpay (optional - enable "Pay with UPI/Card" in Billing)
# Get test keys from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx

# Multi-tenant café id (admin user id = store folder under data/stores/<id>/)
# Staff and kitchen logins require assignedStoreId = this id. If old users.json rows are missing it,
# set this to your café admin's user id so the server can auto-link them on startup.
# DEFAULT_TENANT_ADMIN_ID=U1774110820492

# Log storeId on login and POST /orders (set to 1 or true)
# DEBUG_STORE_ID=
